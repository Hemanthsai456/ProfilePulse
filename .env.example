# Environment Mode: 'development' or 'production'
PROFILEPULSE_ENV=development

# Server Secret: Used for HMAC hashing visitor fingerprints.
# In production, this MUST be a secure random string (minimum 16 characters).
PROFILEPULSE_SECRET=change-this-to-a-secure-secret-key-min-16-chars

# Database path (SQLite file path)
PROFILEPULSE_DB=profilepulse.db

# Rate limit: Max requests per minute per user before serving cached count
PROFILEPULSE_RATE_LIMIT=60

# Active window length in seconds (default: 1800 = 30 minutes)
PROFILEPULSE_WINDOW_SECONDS=1800

# Retention period in days for raw hit logs
PROFILEPULSE_RETENTION_DAYS=30

# Enable GitHub account existence check (true / false)
PROFILEPULSE_VALIDATE_GITHUB_USER=true

# Optional: GitHub Personal Access Token to increase GitHub API rate limits
# from 60 requests/hr (unauthenticated) to 5,000 requests/hr.
# Not required for prototype testing.
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

