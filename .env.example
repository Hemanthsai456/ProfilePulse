# Environment Mode: 'development' or 'production'
PROFILEPULSE_ENV=development

# Server Secret: Used for HMAC hashing visitor fingerprints.
# In production, this MUST be a secure random string (minimum 16 characters).
PROFILEPULSE_SECRET=change-this-to-a-secure-secret-key-min-16-chars

# PostgreSQL connection string.
# Production (Neon): postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Local dev: the docker-compose service provides this automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Separate database used only by the test suite. Never point this at production.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_TEST?sslmode=require

# Rate limit: Max requests per minute per client IP before serving cached count
PROFILEPULSE_RATE_LIMIT=60

# Active window length in seconds (default: 1800 = 30 minutes)
PROFILEPULSE_WINDOW_SECONDS=1800

# Retention period in days for raw hit logs
PROFILEPULSE_RETENTION_DAYS=30

# Trust reverse proxy X-Forwarded-For headers (true / false)
# Set to 'true' ONLY when running behind a trusted reverse proxy (e.g., Render, Nginx, Cloudflare).
# Defaults to false to prevent client IP spoofing.
PROFILEPULSE_TRUST_PROXY=false

# Enable GitHub account existence check (true / false)
PROFILEPULSE_VALIDATE_GITHUB_USER=true

# Optional: GitHub Personal Access Token to increase GitHub API rate limits
# from 60 requests/hr (unauthenticated) to 5,000 requests/hr.
# Not required for prototype testing.
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere
